# The patterns below target stray root-level temp/debug scripts only.
# They are anchored to the repo root (`/`) so they never silently untrack
# a legit `test_*.py` / `check_*.py` / `_*.py` under src/ or a plugin dir.
/_*.py
/_*.txt
# Keep legitimate underscore-prefixed source modules tracked (the /_*.py rule
# above is meant for stray root-level temp scripts, not source packages).
!src/**/_*.py
/test_*.py
/test_*.txt
# Keep legitimate test files under tests/ tracked (the /test_*.py rule above
# is meant for stray root-level scripts, not the pytest suite).
!tests/test_*.py
/start_*.bat
/debug_watchdog.py
scripts/opensquad_watchdog.py
/check_*.py
/find_*.py
/inspect_*.py

# ── Local scratch / diagnostic scripts under scripts/ (not for public) ──
# These are one-off dev diagnostics; keep them out of the tracked tree.
# (The root-level /check_*.py and /test_*.py rules above do not reach
# into scripts/, so list these explicitly.)
scripts/check_completion.py
scripts/test_new_session_ws.py
scripts/manual_tests/

# ── Root-level local dev / debug artifacts (open-source hygiene) ──
/_old_*.py
# Screenshots & UI captures (tracked assets live under src/ or doc_*/)
/*.png
/auth.json
/chat.yaml
/aihelper.yaml
/loggedin.yaml
