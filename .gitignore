# ── Node / Vite / VitePress ───────────────────────────────────
node_modules/
node_modules_old_*/
# Vite / React frontend dist (inside nexuschat-pro — served by backend at runtime,
# but generated by `npm run build`; safe to exclude from source control)
src/opensquad/gateway/nexuschat-pro/dist/
# Plugin UI bundles (React bundles generated by build tools, not source code)
src/plugins/*/ui/index.js
# Electron compiled TypeScript output
src/opensquad/gateway/nexuschat-pro/dist-electron/
# Electron backend binaries (PyInstaller output copied here for local
# electron:dev:fast runs and bundled by electron-builder as extraResources).
# See nexuschat-pro/resources/README.md.
src/opensquad/gateway/nexuschat-pro/resources/backend-*/
# VitePress built output
docs-site/.vitepress/dist/
docs-site-en/.vitepress/dist/
# npm lock files are committed; ignore only generated caches
.vite/

