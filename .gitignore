src/plugins/*/ui/package-lock.json

# ── nexuschat-pro package-lock (platform-specific optional deps like
#    @rollup/rollup-{win32,linux}-x64 make it non-portable across OSes;
#    use `npm install --no-package-lock` in CI instead) ──
src/opensquad/gateway/nexuschat-pro/package-lock.json
