# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py     text eol=lf
*.pyi    text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf

# Web / Node
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.vue    text eol=lf

# Docs
*.md     text eol=lf
*.rst    text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Shell scripts — always LF
*.sh     text eol=lf

# Windows batch — always CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary assets — no line-ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.svg    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.zip    binary
*.gz     binary
*.tar    binary
