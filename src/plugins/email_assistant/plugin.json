{
  "name": "email_assistant",
  "display_name": "Email Assistant",
  "version": "1.0.0",
  "type": "tool",
  "enabled": false,
  "node_scope": "single",
  "description": "General-purpose IMAP/SMTP email plugin. Receives mail via IMAP IDLE, sends via SMTP SSL. Use node_scope=single to avoid duplicate listeners.",
  "author": "OpenSquad",
  "tags": [
    "email",
    "communication"
  ],
  "tools": [
    {
      "name": "list_emails",
      "module": "plugin_api",
      "level": "extended",
      "auto_register": false,
      "requires_agent_id": false
    },
    {
      "name": "read_email",
      "module": "plugin_api",
      "level": "extended",
      "auto_register": false,
      "requires_agent_id": false
    },
    {
      "name": "search_emails",
      "module": "plugin_api",
      "level": "extended",
      "auto_register": false,
      "requires_agent_id": false
    },
    {
      "name": "send_email",
      "module": "plugin_api",
      "level": "extended",
      "auto_register": false,
      "requires_agent_id": false
    }
  ],
  "hooks": [],
  "config": {
    "schema": {
      "imap_host": {
        "type": "string",
        "default": "",
        "description": "IMAP server hostname (e.g. imap.gmail.com)",
        "label": "IMAP 收件服务器",
        "required": true,
        "hint": "用来收信。常见：imap.gmail.com / imap.qq.com / imap.163.com / outlook.office365.com。",
        "placeholder": "imap.gmail.com"
      },
      "imap_port": {
        "type": "integer",
        "default": 993,
        "description": "IMAP server port (993 for SSL)",
        "label": "IMAP 端口",
        "hint": "SSL 通常 993，非加密 143。"
      },
      "imap_ssl": {
        "type": "boolean",
        "default": true,
        "description": "Use SSL for IMAP connection",
        "label": "IMAP 使用 SSL",
        "hint": "保持打开；只有在服务器明确不支持时才关掉。"
      },
      "imap_mailbox": {
        "type": "string",
        "default": "INBOX",
        "description": "Mailbox to monitor (default: INBOX)",
        "label": "监听的邮箱文件夹",
        "hint": "一般是 INBOX（收件箱）。"
      },
      "smtp_host": {
        "type": "string",
        "default": "",
        "description": "SMTP server hostname (e.g. smtp.gmail.com)",
        "label": "SMTP 发件服务器",
        "hint": "用来发信、回信。通常和收件服务器同域：smtp.gmail.com / smtp.qq.com / smtp.163.com。",
        "placeholder": "smtp.gmail.com"
      },
      "smtp_port": {
        "type": "integer",
        "default": 465,
        "description": "SMTP server port (465 for SSL)",
        "label": "SMTP 端口",
        "hint": "SSL 通常 465，STARTTLS 用 587。"
      },
      "username": {
        "type": "string",
        "default": "",
        "description": "Email account username / address",
        "label": "邮箱地址",
        "required": true,
        "hint": "完整邮箱地址，例如 you@example.com。",
        "placeholder": "you@example.com"
      },
      "password": {
        "type": "string",
        "default": "",
        "secret": true,
        "description": "Email account password or app password",
        "label": "应用专用密码 / 授权码",
        "required": true,
        "hint": "通常不是邮箱登录密码：Gmail 要先开两步验证再生成 App Password；QQ/163 在邮箱设置里生成授权码。",
        "help_url": "https://myaccount.google.com/apppasswords"
      }
    }
  },
  "config_schema": {
    "imap_host": {
      "type": "string",
      "default": "",
      "description": "IMAP server hostname (e.g. imap.gmail.com)",
      "label": "IMAP 收件服务器",
      "required": true,
      "hint": "用来收信。常见：imap.gmail.com / imap.qq.com / imap.163.com / outlook.office365.com。",
      "placeholder": "imap.gmail.com"
    },
    "imap_port": {
      "type": "integer",
      "default": 993,
      "description": "IMAP server port (993 for SSL)",
      "label": "IMAP 端口",
      "hint": "SSL 通常 993，非加密 143。"
    },
    "imap_ssl": {
      "type": "boolean",
      "default": true,
      "description": "Use SSL for IMAP connection",
      "label": "IMAP 使用 SSL",
      "hint": "保持打开；只有在服务器明确不支持时才关掉。"
    },
    "imap_mailbox": {
      "type": "string",
      "default": "INBOX",
      "description": "Mailbox to monitor (default: INBOX)",
      "label": "监听的邮箱文件夹",
      "hint": "一般是 INBOX（收件箱）。"
    },
    "smtp_host": {
      "type": "string",
      "default": "",
      "description": "SMTP server hostname (e.g. smtp.gmail.com)",
      "label": "SMTP 发件服务器",
      "hint": "用来发信、回信。通常和收件服务器同域：smtp.gmail.com / smtp.qq.com / smtp.163.com。",
      "placeholder": "smtp.gmail.com"
    },
    "smtp_port": {
      "type": "integer",
      "default": 465,
      "description": "SMTP server port (465 for SSL)",
      "label": "SMTP 端口",
      "hint": "SSL 通常 465，STARTTLS 用 587。"
    },
    "username": {
      "type": "string",
      "default": "",
      "description": "Email account username / address",
      "label": "邮箱地址",
      "required": true,
      "hint": "完整邮箱地址，例如 you@example.com。",
      "placeholder": "you@example.com"
    },
    "password": {
      "type": "string",
      "default": "",
      "secret": true,
      "description": "Email account password or app password",
      "label": "应用专用密码 / 授权码",
      "required": true,
      "hint": "通常不是邮箱登录密码：Gmail 要先开两步验证再生成 App Password；QQ/163 在邮箱设置里生成授权码。",
      "help_url": "https://myaccount.google.com/apppasswords"
    }
  },
  "contributes": {
    "views": [
      {
        "name": "inbox",
        "title": "Email Inbox",
        "icon": "Mail",
        "data_endpoint": "/api/plugins/email_assistant/data"
      }
    ]
  },
  "dependencies": {
    "pip": [
      "imapclient"
    ]
  },
  "setup": {
    "title": "邮箱接入（IMAP 收信 / SMTP 发信）",
    "intro": "先拿到邮箱的「应用专用密码 / 授权码」，再填收件与发件服务器；填完点测试连接会真的登录一次，但不会发信。",
    "steps": [
      {
        "id": "app_password",
        "title": "第 1 步：拿到应用专用密码 / 授权码",
        "description": "绝大多数邮箱不允许第三方用登录密码：需要单独生成一个专用密码。Gmail 要先用两步验证；QQ/163 在「设置 → 账户」里开启 IMAP/SMTP 并生成授权码。",
        "help_url": "https://myaccount.google.com/apppasswords",
        "checklist": [
          "在邮箱后台开启 IMAP/SMTP 服务",
          "生成「应用专用密码」或「授权码」（一串 16 位左右的字符）",
          "记下它——测试连接和保存都要用"
        ]
      },
      {
        "id": "imap",
        "title": "第 2 步：收件设置（IMAP）",
        "description": "收信用的服务器。常见组合：Gmail imap.gmail.com:993、QQ imap.qq.com:993、163 imap.163.com:993，都开 SSL。",
        "fields": [
          "imap_host",
          "imap_port",
          "imap_ssl",
          "imap_mailbox"
        ]
      },
      {
        "id": "smtp",
        "title": "第 3 步：发件设置与账号（SMTP）",
        "description": "发信/回信用的服务器，以及登录账号（完整邮箱地址）与上一步拿到的专用密码。",
        "fields": [
          "smtp_host",
          "smtp_port",
          "username",
          "password"
        ]
      }
    ],
    "verify": {
      "action": "test_connection",
      "label": "测试连接",
      "hint": "会用它真的登录一次 IMAP（配了 SMTP 也会登录一次），不会发送任何邮件。"
    },
    "finish": {
      "label": "保存",
      "note": "保存后即可使用；收信监听会在插件下次加载时启动。"
    }
  }
}
