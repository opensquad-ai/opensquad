{
  "name": "feishu",
  "display_name": "Feishu (Lark)",
  "version": "1.0.0",
  "type": "platform",
  "enabled": true,
  "node_scope": "all",
  "description": "Feishu/Lark platform integration. Provides inbound message adapter and outbound send tools for Feishu groups and users.",
  "author": "OpenSquad",
  "tags": [
    "im"
  ],
  "tools": [
    {
      "name": "feishu_send",
      "module": "proxy",
      "level": "extended",
      "auto_register": true,
      "requires_agent_id": true
    }
  ],
  "hooks": [],
  "service_toggle": true,
  "config": {
    "schema": {
      "service_enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable Feishu service"
      },
      "bots": {
        "type": "bot_list",
        "default": [],
        "description": "Feishu bot list",
        "item_schema": {
          "name": {
            "type": "string",
            "default": "",
            "description": "Bot name"
          },
          "app_id": {
            "type": "string",
            "default": "",
            "description": "App ID"
          },
          "app_secret": {
            "type": "string",
            "default": "",
            "description": "App Secret",
            "secret": true
          },
          "encrypt_key": {
            "type": "string",
            "default": "",
            "description": "Encryption key (optional)",
            "secret": true
          },
          "verification_token": {
            "type": "string",
            "default": "",
            "description": "Verification token (optional)",
            "secret": true
          },
          "agent_id": {
            "type": "string",
            "default": "",
            "description": "Bound Agent ID"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable this bot"
          }
        }
      }
    },
    "section": "feishu"
  },
  "config_schema": {
    "service_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable Feishu service"
    },
    "bots": {
      "type": "bot_list",
      "default": [],
      "description": "Feishu bot list",
      "item_schema": {
        "name": {
          "type": "string",
          "default": "",
          "description": "Bot name"
        },
        "app_id": {
          "type": "string",
          "default": "",
          "description": "App ID"
        },
        "app_secret": {
          "type": "string",
          "default": "",
          "description": "App Secret",
          "secret": true
        },
        "encrypt_key": {
          "type": "string",
          "default": "",
          "description": "Encryption key (optional)",
          "secret": true
        },
        "verification_token": {
          "type": "string",
          "default": "",
          "description": "Verification token (optional)",
          "secret": true
        },
        "agent_id": {
          "type": "string",
          "default": "",
          "description": "Bound Agent ID"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable this bot"
        }
      }
    }
  },
  "contributes": {},
  "dependencies": {
    "pip": [
      "lark-oapi"
    ]
  },
  "service": {
    "entry": "adapter.py",
    "auto_start": true
  }
}