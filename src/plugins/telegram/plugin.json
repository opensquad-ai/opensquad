{
  "name": "telegram",
  "display_name": "Telegram",
  "version": "1.0.0",
  "type": "platform",
  "enabled": true,
  "node_scope": "all",
  "description": "Telegram platform integration. Provides inbound message adapter and outbound send tools for Telegram chats.",
  "author": "OpenSquad",
  "tags": [
    "im"
  ],
  "tools": [
    {
      "name": "telegram_send",
      "module": "proxy",
      "level": "extended",
      "auto_register": true,
      "requires_agent_id": true
    }
  ],
  "hooks": [],
  "config": {
    "schema": {
      "service_enabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable Telegram service",
        "label": "启用 Telegram 服务",
        "hint": "机器人测试通过后再打开；保存后要重启服务才生效。"
      },
      "proxy": {
        "type": "string",
        "default": "",
        "description": "HTTP/SOCKS proxy for Telegram API (e.g. http://127.0.0.1:7890)",
        "label": "代理（可选）",
        "hint": "国内网络访问 api.telegram.org 需要代理，例如 http://127.0.0.1:7890。",
        "placeholder": "http://127.0.0.1:7890"
      },
      "connect_timeout": {
        "type": "integer",
        "default": 30,
        "description": "Connection timeout in seconds",
        "label": "连接超时（秒）"
      },
      "request_timeout": {
        "type": "integer",
        "default": 60,
        "description": "Request timeout in seconds",
        "label": "请求超时（秒）"
      },
      "bots": {
        "type": "bot_list",
        "default": [],
        "description": "Telegram bot list",
        "label": "机器人",
        "hint": "一个 token 只能在一处使用：两台机器填同一个 token 会互相抢消息。",
        "item_schema": {
          "name": {
            "type": "string",
            "default": "",
            "description": "Bot name",
            "label": "机器人备注名",
            "hint": "只在本机显示，方便区分多个机器人。"
          },
          "bot_token": {
            "type": "string",
            "default": "",
            "description": "Bot Token",
            "secret": true,
            "label": "Bot Token",
            "required": true,
            "hint": "在 Telegram 里给 @BotFather 发 /newbot，它会返回这一串（也可以在 /mybots → API Token 里重取）。",
            "help_url": "https://t.me/BotFather",
            "placeholder": "123456789:AAH…",
            "pattern": "^\\d{6,12}:[A-Za-z0-9_-]{30,}$"
          },
          "agent_id": {
            "type": "string",
            "default": "",
            "description": "Bound Agent ID",
            "label": "绑定 Agent",
            "required": true,
            "hint": "这个机器人收到的消息交给哪个 agent 处理：填它的目录名，例如 agent305。",
            "placeholder": "agent305"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable this bot",
            "label": "启用这个机器人"
          }
        }
      }
    }
  },
  "service_toggle": true,
  "service": {
    "entry": "adapter.py",
    "auto_start": true
  },
  "config_schema": {
    "service_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable Telegram service",
      "label": "启用 Telegram 服务",
      "hint": "机器人测试通过后再打开；保存后要重启服务才生效。"
    },
    "proxy": {
      "type": "string",
      "default": "",
      "description": "HTTP/SOCKS proxy for Telegram API (e.g. http://127.0.0.1:7890)",
      "label": "代理（可选）",
      "hint": "国内网络访问 api.telegram.org 需要代理，例如 http://127.0.0.1:7890。",
      "placeholder": "http://127.0.0.1:7890"
    },
    "connect_timeout": {
      "type": "integer",
      "default": 30,
      "description": "Connection timeout in seconds",
      "label": "连接超时（秒）"
    },
    "request_timeout": {
      "type": "integer",
      "default": 60,
      "description": "Request timeout in seconds",
      "label": "请求超时（秒）"
    },
    "bots": {
      "type": "bot_list",
      "default": [],
      "description": "Telegram bot list",
      "label": "机器人",
      "hint": "一个 token 只能在一处使用：两台机器填同一个 token 会互相抢消息。",
      "item_schema": {
        "name": {
          "type": "string",
          "default": "",
          "description": "Bot name",
          "label": "机器人备注名",
          "hint": "只在本机显示，方便区分多个机器人。"
        },
        "bot_token": {
          "type": "string",
          "default": "",
          "description": "Bot Token",
          "secret": true,
          "label": "Bot Token",
          "required": true,
          "hint": "在 Telegram 里给 @BotFather 发 /newbot，它会返回这一串（也可以在 /mybots → API Token 里重取）。",
          "help_url": "https://t.me/BotFather",
          "placeholder": "123456789:AAH…",
          "pattern": "^\\d{6,12}:[A-Za-z0-9_-]{30,}$"
        },
        "agent_id": {
          "type": "string",
          "default": "",
          "description": "Bound Agent ID",
          "label": "绑定 Agent",
          "required": true,
          "hint": "这个机器人收到的消息交给哪个 agent 处理：填它的目录名，例如 agent305。",
          "placeholder": "agent305"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable this bot",
          "label": "启用这个机器人"
        }
      }
    }
  },
  "contributes": {},
  "dependencies": {
    "pip": [
      "requests",
      "python-telegram-bot"
    ]
  },
  "setup": {
    "title": "Telegram 机器人接入",
    "intro": "全程在 Telegram 里完成：先向 @BotFather 申请一个机器人，再把它绑定到本机的一个 agent。",
    "steps": [
      {
        "id": "create_bot",
        "title": "第 1 步：在 Telegram 里创建机器人",
        "description": "打开 Telegram，搜索 @BotFather（官方机器人），发送 /newbot，按提示起两个名字。完成后它会回一条消息，里面就是 token。",
        "help_url": "https://t.me/BotFather",
        "checklist": [
          "搜索并打开 @BotFather",
          "发送 /newbot，按提示回答",
          "复制它返回的 token（形如 123456789:AAH…）"
        ]
      },
      {
        "id": "credentials",
        "title": "第 2 步：粘贴 token 并绑定 agent",
        "description": "token 就是机器人的密码，只填在可信的机器上；同一个 token 不要同时用在两处。",
        "fields": [
          "service_enabled",
          "proxy"
        ],
        "bot_fields": [
          "name",
          "bot_token",
          "agent_id",
          "enabled"
        ]
      }
    ],
    "verify": {
      "action": "test_connection",
      "label": "测试连接",
      "hint": "会用你填的 token 调用 Telegram 的 getMe，成功会显示机器人的 @用户名。"
    },
    "finish": {
      "label": "保存并启用",
      "note": "保存后需要重启 Telegram 服务才生效。"
    }
  }
}
