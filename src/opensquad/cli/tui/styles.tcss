/* OpenSquad TUI — theme-aware (Textual $variables from App.theme) */

Screen {
    background: $background;
    color: $foreground;
}

/* Selection must keep text readable (theme purple bg alone hides grey italics) */
Screen > .screen--selection {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

#header-bar {
    dock: top;
    height: 1;
    background: $background;
    color: $text-muted;
    content-align: left middle;
    padding: 0 2;
}

#chat-log {
    height: 1fr;
    border: none;
    background: $background;
    color: $foreground;
    padding: 1 2;
    overflow-x: hidden;
    /* hide horizontal scrollbar (looks like a thick slider above the prompt) */
    scrollbar-size: 0 1;
    scrollbar-background: $background;
    scrollbar-color: $panel;
}

#live-side {
    height: 1fr;
    border: none;
    background: $background;
    color: $foreground;
    padding: 1 2;
    display: none;
    overflow-x: hidden;
    scrollbar-size: 0 1;
    scrollbar-background: $background;
    scrollbar-color: $panel;
}

#live-side.visible {
    display: block;
}

#chat-log.hidden {
    display: none;
}

/* Live Thinking stream — fixed height while .streaming (app.py uses this class) */
#live-think {
    height: 0;
    min-height: 0;
    max-height: 0;
    overflow-y: hidden;
    background: $background;
    color: $text-muted;
    padding: 0 2;
    margin: 0;
}

#live-think.streaming {
    height: 6;
    min-height: 6;
    max-height: 6;
    padding: 0 2 1 2;
}

#prompt-dock {
    dock: bottom;
    height: auto;
    min-height: 7;
    background: $background;
    padding: 0 2 0 2;
}

/* OpenCode-style command palette above the input */
#slash-menu {
    height: auto;
    max-height: 14;
    display: none;
    background: $panel;
    color: $foreground;
    border: round $primary;
    padding: 0 1;
    margin: 0 0 1 0;
}

#slash-menu.visible {
    display: block;
}

/* Decision / approve / options card (taller for numbered list + descriptions) */
#slash-menu.decision {
    max-height: 22;
    border: solid $primary;
    padding: 1 1;
}

/* Blue box wraps Input only (status row lives below, outside the border) */
#prompt-frame {
    height: auto;
    min-height: 3;
    width: 100%;
    background: $surface;
    padding: 0 1;
    border-top: solid $primary-muted;
    border-right: solid $primary-muted;
    border-bottom: solid $primary-muted;
    border-left: tall $primary;
    overflow-x: hidden;
    overflow-y: hidden;
    scrollbar-size: 0 0;
}

#prompt-frame:focus-within {
    border-top: solid $primary;
    border-right: solid $primary;
    border-bottom: solid $primary;
    border-left: tall $primary;
}

#chat-input {
    width: 1fr;
    background: $surface;
    border: none;
    padding: 0 1;
    color: $foreground;
}

#chat-input:focus {
    border: none;
}

/* Build · model · tokens — under the blue box, not inside it */
#prompt-meta {
    width: 1fr;
    height: 1;
    color: $text-muted;
    background: $background;
    padding: 0 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

#footer-path {
    height: 1;
    color: $text-muted;
    background: $background;
    padding: 0 1;
    margin-top: 0;
}

#status-bar {
    height: 1;
    color: $text-muted;
    background: $background;
    padding: 0 1;
    margin-top: 0;
    display: none;
}

#status-bar.waiting {
    color: $warning;
}

/* Always reserve one row — toggling display caused the prompt to jump/flicker */
#wait-banner {
    height: 1;
    color: $warning;
    background: $background;
    padding: 0 1;
}

Footer {
    background: $panel;
    color: $text-muted;
}

.msg-user {
    color: $secondary;
}

.msg-agent {
    color: $foreground;
}

.msg-system {
    color: $text-muted;
}

.msg-tool {
    color: $accent;
}

.msg-error {
    color: $error;
}
