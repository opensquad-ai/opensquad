/* OpenSquad TUI — theme-aware (Textual $variables from App.theme) */

Screen {
    background: $background;
    color: $foreground;
}

/* Selection must keep text readable (theme purple bg alone hides grey italics) */
Screen > .screen--selection {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}


#header-bar {
    dock: top;
    height: 1;
    min-height: 1;
    max-height: 1;
    background: $background;
    color: $text-muted;
    content-align: left middle;
    padding: 0 2;
    overflow: hidden;
}

#chat-log {
    height: 1fr;
    border: none;
    background: $background;
    color: $foreground;
    padding: 1 2;
    overflow-x: hidden;
    /* hide horizontal scrollbar (looks like a thick slider above the prompt) */
    scrollbar-size: 0 1;
    scrollbar-background: $background;
    scrollbar-color: $panel;
}

#live-side {
    height: 1fr;
    border: none;
    background: $background;
    color: $foreground;
    padding: 1 2;
    display: none;
    overflow-x: hidden;
    scrollbar-size: 0 1;
    scrollbar-background: $background;
    scrollbar-color: $panel;
}

#live-side.visible {
    display: block;
}

#chat-log.hidden {
    display: none;
}

/* Live Thinking stream — fixed height while .streaming (no height:auto thrash) */
#live-think {
    height: 0;
    min-height: 0;
    max-height: 0;
    overflow-y: hidden;
    background: $background;
    color: $text-muted;
    padding: 0 2;
    margin: 0;
}

#live-think.streaming {
    height: 6;
    min-height: 6;
    max-height: 6;
    padding: 0 2 1 2;
}

#prompt-dock {
    dock: bottom;
    /* wait(1)+input(3)+meta(1)+bottom(1) — fixed to stop Win CMD reflow thrash */
    height: 6;
    min-height: 6;
    max-height: 6;
    background: $background;
    padding: 0 2 0 2;
    overflow-x: hidden;
    overflow-y: hidden;
}

#prompt-dock.menu-open {
    height: auto;
    max-height: 22;
    min-height: 6;
    overflow-y: hidden;
}

/* OpenCode-style command palette above the input */
#slash-menu {
    height: auto;
    max-height: 14;
    display: none;
    background: $panel;
    color: $foreground;
    border: solid $primary;
    padding: 0 1;
    margin: 0 0 1 0;
}

#slash-menu.visible {
    display: block;
}

/* Decision / approve / options card — keep compact so chat history stays visible */
#slash-menu.decision {
    max-height: 12;
    border: solid $primary;
    padding: 0 1;
}

/* Token / mode meter — above the input (closer to chat output) */
#prompt-meta {
    width: 1fr;
    height: 1;
    min-height: 1;
    max-height: 1;
    color: $text-muted;
    background: $background;
    padding: 0 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/*
 * Blue send box on the Input itself (not a Vertical wrapper).
 * Win CMD: wrapping Input in a bordered Vertical(height=3) put typed text
 * below the bottom border. Border on Input keeps text inside the box.
 */
#prompt-frame {
    height: 3;
    min-height: 3;
    max-height: 3;
    width: 100%;
    background: $background;
    padding: 0;
    border: none;
    overflow-x: hidden;
    overflow-y: hidden;
    scrollbar-size: 0 0;
}

#chat-input {
    width: 1fr;
    height: 3;
    min-height: 3;
    max-height: 3;
    background: $surface;
    color: $foreground;
    padding: 0 1;
    border-top: solid $primary;
    border-right: solid $primary;
    border-bottom: solid $primary;
    border-left: tall $primary;
}

#chat-input:focus {
    border-top: solid $primary;
    border-right: solid $primary;
    border-bottom: solid $primary;
    border-left: tall $primary;
}

#bottom-status {
    height: 1;
    min-height: 1;
    max-height: 1;
    color: $text-muted;
    background: $background;
    padding: 0 1;
    overflow: hidden;
}

/* Always reserve one row — toggling display caused the prompt to jump/flicker */
#wait-banner {
    height: 1;
    min-height: 1;
    max-height: 1;
    color: $warning;
    background: $background;
    padding: 0 1;
    overflow: hidden;
}

/* Shortcuts live in the input placeholder — do not mount Footer */

.msg-user {
    color: $secondary;
}

.msg-agent {
    color: $foreground;
}

.msg-system {
    color: $text-muted;
}

.msg-tool {
    color: $accent;
}

.msg-error {
    color: $error;
}
