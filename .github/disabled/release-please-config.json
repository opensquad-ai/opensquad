{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "package-name": "opensquad",
  "include-component-in-tag": false,
  "version-file": "pyproject.toml",
  "changelog-path": "CHANGELOG.md",
  "changelog-sections": [
    { "type": "feat",     "section": "Features" },
    { "type": "fix",      "section": "Bug Fixes" },
    { "type": "perf",     "section": "Performance Improvements" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "docs",     "section": "Documentation", "hidden": false },
    { "type": "test",     "section": "Tests", "hidden": true },
    { "type": "build",    "section": "Build System", "hidden": true },
    { "type": "ci",       "section": "Continuous Integration", "hidden": true },
    { "type": "chore",    "section": "Miscellaneous Chores", "hidden": true },
    { "type": "style",    "section": "Styles", "hidden": true },
    { "type": "revert",   "section": "Reverts", "hidden": true }
  ],
  "pull-request-header": ":robot: This release was prepared by release-please.",
  "pull-request-footer": "Merging this PR triggers the existing `.github/workflows/release.yml` (Docker + PyPI + GitHub Release) via the `v*` tag push.",
  "extra-files": [
    "pyproject.toml"
  ],
  "branches": [
    { "branch": "main", "prerelease": false }
  ]
}
