{
  "hosts": {
    "gateway": "127.0.0.1"
  },
  "ports": {
    "gateway": 9555,
    "launcher": 9600,
    "plugin_registry": 9720,
    "frontend": 5173,
    "external_adapter": 9700,
    "websearch": 9001,
    "whisper": 5001
  },
  "gateway": {
    "cors_origins": ["*"]
  },
  "security": {
    "_comment": "Legacy CORS field. Prefer 'gateway.cors_origins' above. ['*'] works out of the box for dev/LAN/Electron; for production with credentials, list your trusted origins explicitly.",
    "cors_allow_origins": ["*"]
  },
  "auth": {
    "node_secret": "YOUR_NODE_SECRET_HERE",
    "gateway_token": "YOUR_GATEWAY_TOKEN_HERE",
    "launcher_token": "YOUR_LAUNCHER_TOKEN_HERE",
    "external_api_key": "YOUR_EXTERNAL_API_KEY_HERE"
  },
  "jwt": {
    "secret_key": "YOUR_JWT_SECRET_KEY_CHANGE_ME_MIN_32_CHARS",
    "algorithm": "HS256",
    "access_token_expire_minutes": 1440
  },
  "node": {
    "id": "my-node-01",
    "label": "My Node (change me)",
    "register_to_gateway": true
  },
  "services": {
    "external_api": {
      "enabled": true
    },
    "feishu": {
      "enabled": false
    }
  },
  "_comment_plugin_dependencies": "Built-in plugin pip dependencies are declared in each plugin's plugin.json. The Launcher auto-installs missing deps at startup."
}
